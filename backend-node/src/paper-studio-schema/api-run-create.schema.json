{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-run-create-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "project_id"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "project_id": { "type": "integer", "minimum": 1 },
    "episode_id": { "type": "integer", "minimum": 1 },
    "paper_episode_id": { "type": "integer", "minimum": 1 },
    "storyboard_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "paper_storyboard_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "expected_paper_storyboard_revisions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "quality_tier": { "enum": ["draft", "balanced", "full-depth"] },
    "image_provider_config_id": { "type": ["integer", "null"], "minimum": 1 },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_images": { "type": "integer", "minimum": 1, "maximum": 500 },
        "max_auto_retries_per_slot": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    }
  },
  "oneOf": [
    {
      "required": ["paper_episode_id", "paper_storyboard_ids", "expected_paper_storyboard_revisions"],
      "properties": {
        "paper_episode_id": { "type": "integer", "minimum": 1 },
        "paper_storyboard_ids": { "type": "array" },
        "expected_paper_storyboard_revisions": { "type": "object" }
      }
    },
    {
      "required": ["episode_id", "storyboard_ids"],
      "properties": {
        "episode_id": { "type": "integer", "minimum": 1 },
        "storyboard_ids": { "type": "array" }
      }
    }
  ]
}
