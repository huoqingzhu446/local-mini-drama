{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-paper-episode-update-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "expected_version"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 4000 },
    "aspect_ratio": { "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"] },
    "fps": { "type": "integer", "minimum": 12, "maximum": 60 },
    "default_duration": { "type": "number", "minimum": 1, "maximum": 120 },
    "status": { "enum": ["draft", "active", "published", "archived"] }
  },
  "minProperties": 3
}
