{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-paper-identity-generate-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "entity_ids"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "image_provider_config_id": { "type": ["integer", "null"], "minimum": 1 },
    "entity_ids": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "integer", "minimum": 1 } }
  }
}
