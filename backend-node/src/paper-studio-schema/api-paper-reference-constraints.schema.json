{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-paper-reference-constraints-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "expected_version", "constraints"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_boxes": { "$ref": "#/$defs/boxes" },
        "prop_boxes": { "$ref": "#/$defs/boxes" },
        "occlusion_boxes": { "$ref": "#/$defs/boxes" },
        "movement_boxes": { "$ref": "#/$defs/boxes" },
        "support_lines": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x1", "y1", "x2", "y2"],
            "properties": {
              "label": { "type": "string", "maxLength": 80 },
              "x1": { "type": "number", "minimum": 0, "maximum": 1 },
              "y1": { "type": "number", "minimum": 0, "maximum": 1 },
              "x2": { "type": "number", "minimum": 0, "maximum": 1 },
              "y2": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "subtitle_safe_area": { "$ref": "#/$defs/box" }
      }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "key": { "type": "string", "maxLength": 80 },
        "label": { "type": "string", "maxLength": 120 },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "boxes": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/box" }
    }
  }
}
