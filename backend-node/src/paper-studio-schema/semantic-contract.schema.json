{
  "$id": "https://localminidrama.local/schemas/paper-studio/semantic-contract-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "storyboard_id", "environment", "subjects", "action_beats"],
  "properties": {
    "schema_version": { "enum": [3, 4] },
    "storyboard_id": { "type": "integer", "minimum": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "clean_plate_required"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "clean_plate_required": { "const": true },
        "registered_boundaries": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "placement_regions": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "kind", "identity"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["character", "prop", "vehicle", "effect"] },
          "identity": { "type": "string", "minLength": 1 },
          "support_key": { "type": ["string", "null"] },
          "required_states": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "placement": { "type": ["object", "null"], "additionalProperties": true }
        }
      }
    },
    "action_beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "start_frame", "peak_frame", "end_frame", "subject_key", "action"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "start_frame": { "type": "integer", "minimum": 0 },
          "peak_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 1 },
          "subject_key": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mobility_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["schema_version", "subject_key", "propulsion_mode", "allow_self_motion", "required_movers", "unit_count"],
        "properties": {
          "schema_version": { "const": 1 },
          "subject_key": { "type": "string", "minLength": 1 },
          "propulsion_mode": { "enum": ["self_powered", "human_push", "human_pull", "animal_drawn", "human_ridden", "crew_operated"] },
          "allow_self_motion": { "type": "boolean" },
          "required_movers": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "unit_count": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "visual_scenes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "visual_beats": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "transition_contracts": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
