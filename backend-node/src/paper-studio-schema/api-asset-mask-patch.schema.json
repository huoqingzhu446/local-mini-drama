{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-asset-mask-patch-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "expected_version", "points"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "x", "y", "radius"],
        "properties": {
          "kind": { "enum": ["foreground", "background"] },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "radius": { "type": "number", "minimum": 0.002, "maximum": 0.25 },
          "strength": { "type": "number", "minimum": 0.05, "maximum": 1 }
        }
      }
    },
    "feather": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
