{
  "$id": "https://localminidrama.local/schemas/paper-studio/source-family-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["family_key", "pattern", "slots", "contract"],
  "properties": {
    "family_key": { "type": "string", "minLength": 1 },
    "pattern": { "enum": ["free", "supported-subject", "registered-environment"] },
    "registration_canvas": {
      "type": ["object", "null"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_key", "asset_type", "generation_purpose"],
        "properties": {
          "slot_key": { "type": "string", "minLength": 1 },
          "asset_type": { "type": "string", "minLength": 1 },
          "generation_purpose": { "type": "string", "minLength": 1 },
          "required_for_gate": { "type": "boolean", "default": true },
          "constraints": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "contract": { "type": "object", "additionalProperties": true }
  }
}
