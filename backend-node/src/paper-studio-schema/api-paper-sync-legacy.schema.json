{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-paper-sync-legacy-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "expected_version", "legacy_episode_id", "confirmed"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "legacy_episode_id": { "type": "integer", "minimum": 1 },
    "legacy_storyboard_id": { "type": ["integer", "null"], "minimum": 1 },
    "confirmed": { "const": true },
    "sync_reference_image": { "type": "boolean" },
    "sync_published_video": { "type": "boolean" }
  }
}
