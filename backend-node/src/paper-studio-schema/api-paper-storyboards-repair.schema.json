{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-paper-storyboards-repair-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "shots"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "script_version_id": { "type": "integer", "minimum": 1 },
    "shots": {
      "$ref": "https://localminidrama.local/schemas/paper-studio/api-paper-storyboards-apply-v1.json#/properties/shots"
    }
  }
}
