{
  "$id": "https://localminidrama.local/schemas/paper-studio/proof-target-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "frame", "target_node_key", "assertions"],
  "properties": {
    "key": { "type": "string", "minLength": 1 },
    "frame": { "type": "integer", "minimum": 0 },
    "target_node_key": { "type": "string", "minLength": 1 },
    "transition_key": { "type": "string", "minLength": 1 },
    "transition_phase": { "enum": ["pre", "start", "mid", "end", "post"] },
    "crop": { "type": "object", "additionalProperties": false, "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }, "required": ["x", "y", "width", "height"] },
    "assertions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string", "minLength": 1 } }, "additionalProperties": true } }
  }
}
