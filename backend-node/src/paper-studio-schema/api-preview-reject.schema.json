{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-preview-reject-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "expected_version", "reason"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "reason": { "type": "string", "minLength": 2, "maxLength": 500 }
  }
}
