{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-asset-rematte-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "expected_version", "asset_version_ids"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "asset_version_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
