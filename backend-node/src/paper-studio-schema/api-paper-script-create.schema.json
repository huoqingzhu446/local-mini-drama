{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-paper-script-create-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "content"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "content": { "type": "string", "minLength": 20, "maxLength": 200000 },
    "source_kind": { "enum": ["manual", "file_upload", "legacy_copy"] }
  }
}
