{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-paper-audio-policy-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "expected_version", "audio_mode"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "audio_mode": { "enum": ["auto", "required", "silent"] }
  }
}
