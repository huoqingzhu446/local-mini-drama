{
  "$id": "https://localminidrama.local/schemas/paper-studio/api-paper-storyboard-generate-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "script_version_id": { "type": "integer", "minimum": 1 },
    "generation_mode": { "enum": ["full", "continuation"] },
    "target_shot_count": { "type": "integer", "minimum": 1, "maximum": 48 },
    "default_duration": { "type": "number", "minimum": 1, "maximum": 120 }
  }
}
